<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="Application.xaml" />
    <Resource Include="Images\Cascade_16x16.png" />
    <Resource Include="Images\TileHorz_16x16.png" />
    <Resource Include="Images\TileVert_16x16.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrismOnDXDocking.ExampleModule\PrismOnDXDocking.ExampleModule.csproj" />
    <ProjectReference Include="..\PrismOnDXDocking.Infrastructure\PrismOnDXDocking.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Wpf.Docking" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.PrismAdapters" Version="26.1.*-*" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
  </ItemGroup>
</Project>
